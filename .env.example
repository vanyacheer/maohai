# === 網站基本設定 ===
# 正式上線後的網址（用於 SEO metadata、sitemap 產生），結尾不要加斜線
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# === 聯絡表單寄信設定（Gmail SMTP）===
# Gmail SMTP 主機，通常不需要改
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 用來寄信的 Gmail 帳號
SMTP_USER=vanyachen88@gmail.com
# 到 Google 帳戶 > 安全性 > 應用程式密碼 產生的 16 碼密碼（不是登入密碼本身）
SMTP_PASS=your-16-digit-app-password
# 表單送出後要收信的信箱（可以跟 SMTP_USER 相同，也可以是另一個信箱）
CONTACT_TO_EMAIL=service@gmail.com

# === CMS 串接設定（目前先不用填，之後接 CMS 時才需要）===
# CONTENT_SOURCE=cms
# CMS_BASE_URL=https://your-cms-domain.com
# CMS_API_TOKEN=your-readonly-token
# CMS_REVALIDATE_SECRET=一組自訂的隨機字串，CMS 發布內容時要帶這組密鑰呼叫 /api/revalidate
